<div class="widget-body no-padding">
  <%= simple_form_for @daily_frequency_compensation,
    url: daily_frequency_compensations_path,
    method: :post,
    html: { class: "smart-form" } do |f| %>
    <%= f.error_notification %>

    <fieldset>
      <div class="alert alert-info" id="daily-frequency-compensation-info">
        <i class="fa-fw fa fa-info"></i>
        <%= t('.info') %>
      </div>

      <div class="row">
        <div class="col col-sm-4">
          <%= f.input :unity_id, as: :select2_unity, user: current_user %>
        </div>

        <div class="col col-sm-4">
          <%= f.input :classroom_id, as: :select2, elements: [current_user_classroom], readonly: true,
                input_html: { value: current_user_classroom.id } %>
        </div>

        <div class="col col-sm-4">
          <% if current_user_discipline.present? %>
            <%= f.input :discipline_id, as: :select2, elements: [current_user_discipline], readonly: true,
                  input_html: { value: current_user_discipline.id } %>
          <% end %>
        </div>
      </div>

      <div class="row">
        <div class="col col-sm-4">
          <%= f.input :compensation_date, as: :date, required: true %>
        </div>

        <div class="col col-sm-8">
          <%= f.input :lesson_numbers, as: :check_boxes, collection: @lesson_numbers,
                required: true, label: DailyFrequencyCompensation.human_attribute_name(:lesson_numbers) %>
        </div>
      </div>

      <div class="row">
        <div class="col col-sm-12">
          <%= f.input :reason, as: :text, required: true, input_html: { rows: 3 } %>
        </div>
      </div>
    </fieldset>

    <footer>
      <%= f.submit t('.save'), class: 'btn btn-primary' %>
    </footer>
  <% end %>
</div>
